<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+. android:allowBackup="false" covers cloud backup on every version,
  but device-to-device transfer is governed only by this file, so both sections
  have to exclude the whole package explicitly.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
