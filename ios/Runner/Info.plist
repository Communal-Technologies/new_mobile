<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Wallet</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>mobile</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Communal needs photo access to let you save or share transaction receipts.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Communal saves your transaction receipts directly to the photo library.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Communal uses Face ID to securely authenticate you when signing in.</string>
	<!--
		Needed for the messages firebase_messaging handles while the app is not
		in the foreground. An alert push would arrive without it; a data-only
		message — which is how a balance or an approval is refreshed silently —
		would be dropped by iOS.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!--
		Answers Apple's export-compliance question in the build itself. Without
		it, every upload sits in App Store Connect as "Missing Compliance" until
		someone answers the same question by hand in the web UI, which blocks the
		build from reaching testers.

		`false` is the declaration that the app uses no *non-exempt* encryption:
		HTTPS/TLS, the Keychain, and the Secure Enclave signing in
		BiometricKeyChannel are all Apple-provided and exempt, and `crypto` is
		used for hashing, which is not encryption. Adding our own cipher over
		stored or transmitted data would make this answer wrong.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!--
		Audit M10: explicit App Transport Security policy. iOS enforces
		HTTPS-only by default, but we set it explicitly so a future change
		to NSAllowsArbitraryLoads is intentional rather than accidental.

		If a developer ever needs an HTTP exception for a local dev server,
		add it here per-domain via NSExceptionDomains — never flip
		NSAllowsArbitraryLoads to true. Production and staging API hosts
		are HTTPS, so no exceptions are required for shipped builds.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>
</dict>
</plist>
